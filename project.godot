; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="看得见的一公里 演示版"
config/version="0.3.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

DataRepository="*res://scripts/autoload/DataRepository.gd"
GameState="*res://scripts/autoload/GameState.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
ResourceManager="*res://scripts/autoload/ResourceManager.gd"
DayCycle="*res://scripts/autoload/DayCycle.gd"
TutorialManager="*res://scripts/autoload/TutorialManager.gd"
AIDirector="*res://scripts/autoload/AIDirector.gd"
EventManager="*res://scripts/autoload/EventManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
SteamBridge="*res://scripts/autoload/SteamBridge.gd"
McpBridgeGame="*res://mcp_bridge_game.gd"
PlaytestServer="*uid://cwsas53mqheh7"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/mcp_bridge/plugin.cfg", "res://addons/godot_ai_playtest/plugin.cfg")

[input]

toggle_debug_panel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":120,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
